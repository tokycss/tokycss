{"extends": ["stylelint-config-standard"], "ignoreFiles": ["dist/**"], "rules": {"custom-property-pattern": "^_?[a-z][a-z0-9]*(-[a-z0-9]+)*$", "selector-class-pattern": "^[a-z][a-zA-Z0-9-]+$", "max-nesting-depth": 3, "selector-max-compound-selectors": 6, "comment-empty-line-before": null, "custom-property-empty-line-before": null, "comment-whitespace-inside": null, "hue-degree-notation": null, "lightness-notation": null, "alpha-value-notation": null, "color-function-notation": null, "value-keyword-case": null, "no-descending-specificity": null, "at-rule-empty-line-before": null, "selector-pseudo-element-colon-notation": null, "declaration-block-no-redundant-longhand-properties": null, "keyframe-selector-notation": null, "no-duplicate-selectors": null, "property-no-vendor-prefix": null, "selector-attribute-quotes": null}}